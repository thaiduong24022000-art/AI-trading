# Mọi khoá trong file này dán được từ web UI (tab Cấu hình > Khoá API), và
# bấm "Thử kết nối sàn" ngay sau đó để biết khoá có chạy không. UI ghi được
# nhưng không đọc lại được — muốn xem giá trị thì mở file này.
#
# Chọn sàn: bybit | okx. Client thực tế được chọn ở src/exchange.py.
EXCHANGE=bybit

# Bybit API (lấy tại testnet.bybit.com hoặc bybit.com > API Management)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# OKX API (lấy tại OKX > Profile > API. OKX bắt buộc có PASSPHRASE, tự đặt
# lúc tạo key - khác Bybit chỉ có key/secret). Bật demo trading trên OKX
# trước khi lấy key: khi bật, key tạo ra chỉ dùng được cho tiền giả.
#   - BẬT quyền Trade, TẮT quyền Withdraw, bật IP whitelist nếu chạy VPS
#   - OKX_DEMO=true tương đương BYBIT_TESTNET=true (tiền giả)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEMO=true
# Chế độ margin khi CATEGORY=linear (spot luôn "cash", không đọc biến này): cross|isolated
OKX_TD_MODE=cross

# Anthropic API key (dùng cho lớp phân tích sentiment)
ANTHROPIC_API_KEY=

# ==========================================================
# Cảnh báo Telegram (mặc định TẮT)
#
# Bot chạy trên máy cá nhân thì log cũng nằm trên máy cá nhân — nghĩa là
# không ai biết gì cho tới lúc mở máy ra xem. Bot từng crash-loop 6 tiếng
# vì API key hết hạn, log ghi đủ ngay từ lần đầu, không ai đọc.
#
#   TELEGRAM_BOT_TOKEN : chat với @BotFather trên Telegram -> /newbot
#   TELEGRAM_CHAT_ID   : chat với @userinfobot -> nó trả về id của bạn
#
# Token nhạy cảm ngang API key sàn — ai có token đều gửi được tin giả danh
# bot của bạn. Nó nằm trong .gitignore và không bao giờ hiện trên web UI.
# ==========================================================
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Báo từng lệnh mở/đóng. Tắt nếu chạy nhiều mã và thấy ồn.
TELEGRAM_BAO_TUNG_LENH=true

# An toàn: để true cho đến khi đã backtest + paper trade kỹ
DRY_RUN=true

# Lưới an toàn: bot tự đóng vị thế khi giá đã xuyên stop mà sàn vẫn báo còn mở.
# Stop đặt ở sàn có thể KHÔNG tồn tại mà bot vẫn tưởng là có — sai tên tham số,
# lệnh algo bị từ chối, hoặc lỗi phía sàn. Khi đó sàn vẫn khớp lệnh chính và âm
# thầm bỏ qua phần stop, để lại một vị thế không có bảo vệ.
# Để true trừ khi bạn có lý do rất cụ thể.
EP_STOP_PHIA_BOT=true

# ==========================================================
# AI policy + vòng học liên tục
# ==========================================================
# off | shadow | filter | active  -- xem docs/vong-hoc-lien-tuc.md
# Mô hình mới LUÔN bắt đầu ở shadow. Đổi chế độ là quyết định của người,
# vòng học không bao giờ tự nâng chế độ lên.
POLICY_MODE=off

# Xếp hạng cắt ngang cần bề rộng. Dưới ngưỡng này policy từ chối có ý kiến,
# nên nếu chạy policy thật thì SYMBOLS phải có ít nhất chừng này mã.
POLICY_MIN_MA=8

# Ngưỡng ra quyết định tính bằng kỳ vọng lợi nhuận ròng mỗi lệnh (đã trừ phí),
# không phải bằng xác suất. Phí/barrier đổi thì ngưỡng tự điều chỉnh theo.
POLICY_EV_MIN=0.0015
POLICY_EV_FULL=0.012
